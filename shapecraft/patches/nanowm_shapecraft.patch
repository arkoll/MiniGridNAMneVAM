diff --git a/src/callbacks_shapecraft.py b/src/callbacks_shapecraft.py
new file mode 100644
index 0000000..49ecf42
--- /dev/null
+++ b/src/callbacks_shapecraft.py
@@ -0,0 +1,142 @@
+"""Метрики валидации под нашу гипотезу ShapeCraft: раздельно по val_id и val_ood.
+
+Зачем отдельный коллбэк. Валидационный набор у нас склеен из двух: `val_id` — знакомые
+привязки цвета к форме на новых раскладках, `val_ood` — привязки, которых в обучении не
+было. Штатные скаляры усредняются по всему набору и разницу между ними не показывают,
+а именно эта разница и есть предмет эксперимента.
+
+Пиксельные метрики намеренно не считаем: превращение объекта занимает одну клетку из 64,
+и любое усреднение по кадру его не видит. Считаем то, что относится к делу:
+предсказание действий по одному наблюдаемому кадру.
+
+Коллбэк устроен так, чтобы не ронять длинный прогон: если раскладка данных окажется не
+такой, как ожидается, он один раз пишет предупреждение и молча выключается.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+from pytorch_lightning.callbacks import Callback
+from pytorch_lightning.utilities import rank_zero_only
+
+
+class ShapeCraftSplitActionMetrics(Callback):
+    """Точность предсказания действий отдельно на val_id и val_ood."""
+
+    SETS = ("val_id", "val_ood")
+
+    def __init__(self, num_transitions: int = 3):
+        super().__init__()
+        self.num_transitions = int(num_transitions)
+        self._files = None
+        self._disabled = False
+        self._reset()
+
+    def _reset(self):
+        self._hits = {s: torch.zeros(self.num_transitions) for s in self.SETS}
+        self._seq_hits = {s: 0.0 for s in self.SETS}
+        self._counts = {s: 0 for s in self.SETS}
+
+    def _resolve_files(self, trainer):
+        """Список файлов валидационного источника: по нему определяем, из какого набора окно."""
+        loaders = trainer.val_dataloaders
+        if isinstance(loaders, (list, tuple)):
+            if not loaders:
+                return None
+            loaders = loaders[0]
+        dataset = getattr(loaders, "dataset", None)
+        source = getattr(dataset, "data_source", None)
+        files = getattr(source, "files", None)
+        if not files:
+            return None
+        return [os.path.basename(str(f)) for f in files]
+
+    @staticmethod
+    def _set_of(name: str):
+        # имена присвоены конвертером: episode_train_id_* и episode_train_ood_*
+        if "_ood_" in name:
+            return "val_ood"
+        if "_id_" in name:
+            return "val_id"
+        return None
+
+    def on_validation_epoch_start(self, trainer, pl_module):
+        self._reset()
+        if self._disabled:
+            return
+        self._files = self._resolve_files(trainer)
+        if self._files is None and not self._disabled:
+            self._disabled = True
+            print(
+                "[ShapeCraftSplitActionMetrics] не удалось получить список файлов валидации, "
+                "раздельные метрики выключены",
+                flush=True,
+            )
+
+    @torch.no_grad()
+    def on_validation_batch_end(
+        self, trainer, pl_module, outputs, batch, batch_idx, dataloader_idx=0
+    ):
+        if self._disabled or self._files is None or trainer.sanity_checking:
+            return
+        try:
+            logits = pl_module.predict_action_logits(batch["video"])
+        except Exception as error:  # длинный прогон важнее метрики
+            self._disabled = True
+            print(f"[ShapeCraftSplitActionMetrics] отключаюсь: {error}", flush=True)
+            return
+
+        n = min(self.num_transitions, logits.shape[1])
+        targets = batch["action"][:, :n]
+        if targets.ndim == 3:
+            targets = targets.argmax(dim=-1)
+        targets = targets.long().to(logits.device)
+        predicted = logits[:, :n].argmax(dim=-1)
+        correct = (predicted == targets).float().cpu()
+
+        traj = batch["meta_info"]["traj_idx"]
+        for i in range(correct.shape[0]):
+            index = int(traj[i])
+            if index >= len(self._files):
+                continue
+            which = self._set_of(self._files[index])
+            if which is None:
+                continue
+            self._hits[which][:n] += correct[i]
+            self._seq_hits[which] += float(correct[i].all())
+            self._counts[which] += 1
+
+    @rank_zero_only
+    def on_validation_epoch_end(self, trainer, pl_module):
+        if self._disabled or trainer.sanity_checking:
+            return
+        summary = {}
+        for s in self.SETS:
+            count = self._counts[s]
+            if count == 0:
+                continue
+            per_position = (self._hits[s] / count).tolist()
+            mean_accuracy = float(sum(per_position) / len(per_position))
+            summary[s] = mean_accuracy
+            pl_module.log(f"val_split/{s}/action_accuracy", mean_accuracy, sync_dist=False)
+            pl_module.log(
+                f"val_split/{s}/action_sequence_accuracy",
+                self._seq_hits[s] / count,
+                sync_dist=False,
+            )
+            pl_module.log(f"val_split/{s}/windows", float(count), sync_dist=False)
+            for position, value in enumerate(per_position):
+                pl_module.log(f"val_split/{s}/action_accuracy_t{position}", value, sync_dist=False)
+            print(
+                f"[ShapeCraft] {s}: окон {count}, точность по действиям {mean_accuracy:.4f}, "
+                f"вся тройка {self._seq_hits[s] / count:.4f}, по шагам "
+                + ", ".join(f"t{p}={v:.4f}" for p, v in enumerate(per_position)),
+                flush=True,
+            )
+        # главное число эксперимента: насколько просела точность на невиданных привязках
+        if "val_id" in summary and "val_ood" in summary:
+            gap = summary["val_id"] - summary["val_ood"]
+            pl_module.log("val_split/ood_gap_action_accuracy", gap, sync_dist=False)
+            print(f"[ShapeCraft] разрыв val_id минус val_ood: {gap:+.4f}", flush=True)
