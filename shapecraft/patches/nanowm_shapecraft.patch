+# @package experiment
+#
+# То же, что xland_joint у ментора, но с раздельными метриками по нашим двум валидациям
+# и без пиксельных метрик. Параметры МОДЕЛИ не трогаются вообще: они заморожены.
+defaults:
+  - xland_joint
+
+joint_action:
+  # считать точность действий отдельно на val_id и val_ood
+  split_action_metrics: true
+
+evaluation:
+  # пиксельные метрики и FVD выключены намеренно: превращение объекта — одна клетка
+  # из 64, усреднение по кадру его не видит
+  metrics:
+    evaluate: false
+  save_videos: false
