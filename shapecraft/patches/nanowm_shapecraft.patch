diff --git a/src/configs/dataset/xland/shapecraft_ours.yaml b/src/configs/dataset/xland/shapecraft_ours.yaml
new file mode 100644
index 0000000..e926dc6
--- /dev/null
+++ b/src/configs/dataset/xland/shapecraft_ours.yaml
@@ -0,0 +1,35 @@
+# @package dataset
+#
+# Наши наборы ShapeCraft, конвертированные в формат joint-модели (npz, 128 px).
+# Сбор ментора пропущен намеренно: он собирает ExactCraft, а гипотеза наша — ShapeCraft.
+#
+# Обучение идёт по нашему train, валидация — по СКЛЕЕННОМУ каталогу val_both, куда
+# символическими ссылками сведены val_id (знакомые привязки, новые раскладки) и
+# val_ood (невиданные привязки цвета к форме). Раздельные числа считает
+# ShapeCraftSplitActionMetrics: разница между ними и есть предмет эксперимента.
+name: "xland"
+frame_interval: 1
+loader:
+  n_rollout: null
+  data_path: "${dataset_dir}/xland-shape-joint128/train"
+  # раздельные каталоги: split_ratio при этом не используется вовсе
+  data_path_train: "${dataset_dir}/xland-shape-joint128/train"
+  data_path_val: "${dataset_dir}/xland-shape-joint128/val_both"
+  split_ratio: 0.9
+  validation_size: null
+  normalize_state: false
+  # действия one-hot, нормировать нечего; нормировка по статистике — ещё и канал утечки
+  normalize_action: false
+  normalize_pixel: true
+  train_slice_mode: "random"
+  val_slice_mode: "exhaustive"
+  stride: 1
+  resize_mode: "stretch"
+  random_seed: 42
+  # окна валидации фиксируются один раз и переиспользуются на всех замерах,
+  # иначе шаги обучения сравнивались бы на разных окнах
+  validation_fixed_subset_path: null
+  validation_fixed_subset_size: 1024
+  validation_fixed_subset_seed: 4242
+spec:
+  action_dim: 6
