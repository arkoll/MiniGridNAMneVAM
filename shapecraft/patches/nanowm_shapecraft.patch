+# @package dataset
+#
+# Смешанный набор с ЭКСПЕРТНОЙ разметкой (DAgger-подобный).
+#
+# Половина эпизодов — жадный эксперт, половина — случайная политика по допустимым действиям.
+# Целевое действие в КАЖДОМ кадре обеих половин — действие эксперта, спрошенного в этом
+# состоянии. На случайных эпизодах выполненное действие и метка расходятся намеренно: так
+# модель учится, что делать из состояний, куда сама сойдёт с экспертного пути.
+#
+# Состав по кадрам, а не по эпизодам: экспертный эпизод ~28 кадров, случайный всегда 193,
+# поэтому около 87% окон приходит из случайных. Это осознанная ставка на покрытие состояний.
+#
+# Валидации собраны тем же составом, иначе их метрики не сравнивались бы с обучением.
+name: "xland"
+frame_interval: 1
+loader:
+  n_rollout: null
+  data_path: "${dataset_dir}/xland-dagger/train"
+  data_path_train: "${dataset_dir}/xland-dagger/train"
+  data_path_val: "${dataset_dir}/xland-dagger/val_both"
+  split_ratio: 0.9
+  validation_size: null
+  normalize_state: false
+  normalize_action: false
+  normalize_pixel: true
+  train_slice_mode: "random"
+  val_slice_mode: "exhaustive"
+  stride: 1
+  resize_mode: "stretch"
+  random_seed: 42
+  validation_fixed_subset_path: null
+  validation_fixed_subset_size: 1024
+  validation_fixed_subset_seed: 4242
+spec:
+  action_dim: 6
