+#!/usr/bin/env python3
+"""Reserve a deterministic 1,000-episode OOD suite; no trajectories are generated."""
+from __future__ import annotations
+import json
+from pathlib import Path
+from xminigrid.envs.five_object_crafting import TASKS
+
+ROOT = Path(__file__).resolve().parents[1] / "artifacts" / "ood_different_task_trees_v1"
+SEED_START = 8_000_000
+EPISODES = 1000
+ENV_ID = "XLand-MiniGrid-ExactCraft-Medium-8x8-v1"
+
+def main():
+    heldout = [task for task in TASKS if task.split == "val"]
+    if not heldout:
+        raise RuntimeError("No held-out Medium task trees found")
+    ROOT.mkdir(parents=True, exist_ok=True)
+    manifest = ROOT / "manifest_1000.jsonl"
+    with manifest.open("w", encoding="utf-8") as handle:
+        for index in range(EPISODES):
+            task = heldout[index % len(heldout)]
+            handle.write(json.dumps({
+                "episode": index,
+                "environment": ENV_ID,
+                "task_id": task.task_id,
+                "task_tree_rules": list(task.rule_text),
+                "seed": SEED_START + index,
+                "split": "ood_depth3_heldout_tree",
+                "train_data_exposure": False,
+            }, sort_keys=True) + "\n")
+    summary = {
+        "episodes": EPISODES,
+        "environment": ENV_ID,
+        "seed_start": SEED_START,
+        "heldout_task_ids": [task.task_id for task in heldout],
+        "heldout_task_trees": {str(task.task_id): list(task.rule_text) for task in heldout},
+        "definition": "Depth-3 crafting dependency trees unseen by a WAM trained only on ExactCraft Easy depth-2 trajectories.",
+        "not_trajectories": True,
+        "evaluation": "Run WAM closed-loop on each (task_id, seed); report SR and path length.",
+    }
+    (ROOT / "README.json").write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n")
+    print(json.dumps(summary, indent=2))
+
+if __name__ == "__main__":
+    main()
