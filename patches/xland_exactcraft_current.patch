+#!/usr/bin/env python3
+"""Collect successful symbolic XLand trajectories from an existing PPO checkpoint."""
+from __future__ import annotations
+import argparse
+import json
+import sys
+import types
+from pathlib import Path
+
+# The training module imports tensorboardX only for training-time logging.
+# Trajectory inference does not use it, so provide a no-op substitute.
+class _NoOpSummaryWriter:
+    def __init__(self, *args, **kwargs): pass
+    def add_scalar(self, *args, **kwargs): pass
+    def close(self): pass
+_tensorboardx = types.ModuleType("tensorboardX")
+_tensorboardx.SummaryWriter = _NoOpSummaryWriter
+sys.modules.setdefault("tensorboardX", _tensorboardx)
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+
+import jax
+import jax.numpy as jnp
+import numpy as np
+import optax
+from flax import serialization
+from flax.training.train_state import TrainState
+
+from training.train_privileged_crafting_ppo import (
+    Config, PrivilegedActorCritic, embodiment_spec, make_env, task_banks,
+)
+
+def restore(run_dir: Path, checkpoint: Path):
+    config = Config(**json.loads((run_dir / "config.json").read_text()))
+    benchmark, _ = task_banks(config.env_id)
+    env, base_params = make_env(config.env_id, autoreset=False)
+    _, direction_count = embodiment_spec(config.env_id)
+    network = PrivilegedActorCritic(
+        num_actions=env.num_actions(base_params),
+        agent_direction_classes=direction_count + 1,
+    )
+    key = jax.random.key(config.seed)
+    key, init_key, reset_key = jax.random.split(key, 3)
+    init_params = base_params.replace(ruleset=benchmark.get_ruleset(0))
+    init_timestep = env.reset(init_params, reset_key)
+    params = network.init(init_key, jax.tree.map(lambda x: x[None], init_timestep.observation))
+    schedule = optax.warmup_cosine_decay_schedule(
+        init_value=config.learning_rate * 0.1,
+        peak_value=config.learning_rate,
+        warmup_steps=100,
+        decay_steps=max(101, config.total_timesteps // config.transitions_per_update * config.update_epochs * config.num_minibatches),
+        end_value=config.learning_rate * 0.05,
+    )
+    tx = optax.chain(optax.clip_by_global_norm(config.max_grad_norm), optax.adam(schedule, eps=1e-5))
+    state = TrainState.create(apply_fn=network.apply, params=params, tx=tx)
+    state = serialization.from_bytes(state, (checkpoint / "train_state.msgpack").read_bytes())
+    return config, benchmark, env, base_params, network, state
+
+def make_rollout(env, base_params, network):
+    max_steps = int(base_params.max_steps)
+    def rollout(params, reset_keys, policy_params):
+        timestep = jax.vmap(env.reset)(params, reset_keys)
+        done = jnp.zeros((reset_keys.shape[0],), dtype=jnp.bool_)
+        success = jnp.zeros_like(done)
+        lengths = jnp.zeros((reset_keys.shape[0],), dtype=jnp.int32)
+        def one_step(carry, _):
+            timestep, done, success, lengths = carry
+            dist, _ = network.apply(policy_params, timestep.observation)
+            action = dist.mode()
+            def advance(param, ts, act, is_done):
+                return jax.lax.cond(is_done, lambda _: ts, lambda _: env.step(param, ts, act), operand=None)
+            next_timestep = jax.vmap(advance)(params, timestep, action, done)
+            active = ~done
+            terminal = active & next_timestep.last()
+            success = success | (terminal & (next_timestep.reward > 0.9))
+            lengths = lengths + active.astype(jnp.int32)
+            record = {
+                "obs": timestep.observation,
+                "next_obs": next_timestep.observation,
+                "action": action,
+                "reward": next_timestep.reward,
+                "active": active,
+            }
+            return (next_timestep, done | terminal, success, lengths), record
+        (_, _, success, lengths), records = jax.lax.scan(one_step, (timestep, done, success, lengths), None, length=max_steps)
+        return records, success, lengths
+    return jax.jit(rollout)
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--run-dir", type=Path, required=True)
+    p.add_argument("--checkpoint", type=Path, required=True)
+    p.add_argument("--output-dir", type=Path, required=True)
+    p.add_argument("--episodes", type=int, default=10_000)
+    p.add_argument("--batch-size", type=int, default=256)
+    p.add_argument("--seed", type=int, default=20260731)
+    a = p.parse_args()
+    a.output_dir.mkdir(parents=True, exist_ok=True)
+    config, benchmark, env, base_params, network, state = restore(a.run_dir, a.checkpoint)
+    rollout = make_rollout(env, base_params, network)
+    key = jax.random.key(a.seed)
+    accepted = attempts = 0
+    manifest = a.output_dir / "manifest.jsonl"
+    with manifest.open("w") as log:
+        while accepted < a.episodes:
+            key, task_key, reset_key = jax.random.split(key, 3)
+            task_keys = jax.random.split(task_key, a.batch_size)
+            reset_keys = jax.random.split(reset_key, a.batch_size)
+            rulesets = jax.vmap(benchmark.sample_ruleset)(task_keys)
+            params = base_params.replace(ruleset=rulesets)
+            records, successes, lengths = jax.device_get(rollout(params, reset_keys, state.params))
+            successes, lengths = np.asarray(successes), np.asarray(lengths)
+            attempts += a.batch_size
+            for i in np.flatnonzero(successes):
+                if accepted >= a.episodes:
+                    break
+                length = int(lengths[i])
+                payload = {
+                    "obs": np.asarray(records["obs"]["img"][:length, i], dtype=np.uint8),
+                    "next_obs": np.asarray(records["next_obs"]["img"][:length, i], dtype=np.uint8),
+                    "actions": np.asarray(records["action"][:length, i], dtype=np.int8),
+                    "rewards": np.asarray(records["reward"][:length, i], dtype=np.float32),
+                    "rule_encoding": np.asarray(records["obs"]["rule_encoding"][0, i], dtype=np.int16),
+                    "goal_encoding": np.asarray(records["obs"]["goal_encoding"][0, i], dtype=np.int16),
+                }
+                filename = f"episode_{accepted:05d}.npz"
+                np.savez_compressed(a.output_dir / filename, **payload)
+                log.write(json.dumps({"episode": accepted, "file": filename, "length": length}) + "\n")
+                accepted += 1
+            if accepted % 500 < a.batch_size:
+                print(json.dumps({"accepted_successes": accepted, "attempted_episodes": attempts}), flush=True)
+    summary = {
+        "episodes": accepted, "attempted_episodes": attempts, "success_rate_during_collection": accepted / attempts,
+        "source_run": str(a.run_dir), "checkpoint": str(a.checkpoint), "environment": config.env_id,
+        "policy": "deterministic PPO argmax", "format": "one compressed NPZ per successful episode; symbolic obs/next_obs/actions/rewards",
+    }
+    (a.output_dir / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")
+    print(json.dumps(summary, indent=2), flush=True)
+
+if __name__ == "__main__":
+    main()
