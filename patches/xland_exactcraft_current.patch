+class ShapeTileNearRule(BaseRule):
+    """Transform adjacent shapes regardless of the two input colors.
+
+    The produced object keeps the full tile/color identity specified by the
+    task.  Shape order is intentionally symmetric.
+    """
+
+    shape_a: jax.Array
+    shape_b: jax.Array
+    prod_tile: jax.Array
+
+    def __call__(self, grid, agent, action, position):
+        tile = grid[position[0], position[1]]
+        tile_shape = tile[0]
+
+        def _matches_pair(other_tile):
+            other_shape = other_tile[0]
+            return (
+                (jnp.equal(tile_shape, self.shape_a) & jnp.equal(other_shape, self.shape_b))
+                | (jnp.equal(tile_shape, self.shape_b) & jnp.equal(other_shape, self.shape_a))
+            )
+
+        def _rule_fn(grid):
+            floor_tile = TILES_REGISTRY[Tiles.FLOOR, Colors.BLACK]
+            y, x = position
+            up, right, down, left = get_neighbouring_tiles(grid, y, x)
+
+            grid = jax.lax.select(
+                _matches_pair(up),
+                grid.at[y - 1, x].set(self.prod_tile).at[y, x].set(floor_tile),
+                grid,
+            )
+            grid = jax.lax.select(
+                _matches_pair(right),
+                grid.at[y, x + 1].set(self.prod_tile).at[y, x].set(floor_tile),
+                grid,
+            )
+            grid = jax.lax.select(
+                _matches_pair(down),
+                grid.at[y + 1, x].set(self.prod_tile).at[y, x].set(floor_tile),
+                grid,
+            )
+            grid = jax.lax.select(
+                _matches_pair(left),
+                grid.at[y, x - 1].set(self.prod_tile).at[y, x].set(floor_tile),
+                grid,
+            )
+            return grid
+
+        is_input_shape = jnp.equal(tile_shape, self.shape_a) | jnp.equal(tile_shape, self.shape_b)
+        grid = jax.lax.cond(
+            jnp.equal(action, 4) & is_input_shape,
+            lambda: _rule_fn(grid),
+            lambda: grid,
+        )
+        return grid, agent
+
+    @classmethod
+    def decode(cls, encoding):
+        return cls(
+            shape_a=encoding[1],
+            shape_b=encoding[2],
+            prod_tile=encoding[3:5],
+        )
+
+    def encode(self):
+        encoding = jnp.hstack(
+            (
+                jnp.asarray([12], dtype=jnp.uint8),
+                jnp.asarray([self.shape_a, self.shape_b], dtype=jnp.uint8),
+                self.prod_tile,
+            )
+        )
+        return pad_along_axis(encoding, MAX_RULE_ENCODING_LEN)
+
+
 # tile_b should be one tile up near the tile_a
 class TileNearUpRule(BaseRule):
     tile_a: jax.Array
